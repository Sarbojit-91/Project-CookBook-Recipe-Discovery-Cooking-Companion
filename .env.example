# Copy to .env.local and fill in. .env.local is git-ignored — never commit real values.
# Needed from Phase 6 (accounts and personal data). Recipe pages work without them.

# Supabase project URL and public "anon" key (Project Settings → API).
# The anon key is designed to be public; row-level security protects user data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Do NOT add the Supabase service-role key here. The app never uses it.
