# Copy to .env.local and fill in. .env.local is git-ignored — never commit real values.

# Public URL of the site, used for the sitemap, social previews and links in emails.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: Supabase accounts (sync between devices). Leave empty and everything is saved on the
# user's device instead. Find both values in Supabase → Project Settings → API. The "anon" or
# "publishable" key is designed to be public; row-level security protects every user's data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Do NOT add the Supabase service-role / secret key here. The app never uses it.
